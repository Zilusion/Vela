					+menuItem({ title: 'Складные смартфоны', href: '/catalog/foldable', count: 30 })
					+menuItem({ title: 'Кнопочные телефоны', href: '/catalog/feature-phones', count: 23 })
			.mega-menu__column
				h3.mega-menu__column-title Гаджеты
				ul.mega-menu__nav-list(role="menu")
					+menuItem({ title: 'Смарт-часы', href: '/catalog/smartwatch', count: 115 })
					+menuItem({ title: 'Фитнес-браслеты', href: '/catalog/fitness-trackers', count: 88 })
