		+menuPanel({ panelId: 'audio', level: 2, parentPanelId: 'root', title: 'Аудиотехника' })
			ul.mega-menu__nav-list(role="menu")
				+menuItem({ title: 'Наушники и гарнитуры', href: '/catalog/headsets', count: 350})
				+menuItem({ title: 'Портативная акустика', href: '/catalog/portable-speakers', count: 142 })
				+menuItem({ title: 'Домашние аудиосистемы', href: '/catalog/home-audio', count: 65 })
				+menuItem({ title: 'Виниловые проигрыватели', href: '/catalog/turntables', count: 40 })
