include mixins/_icon.pug
include mixins/_language-switcher.pug
include mixins/_location.pug
include mixins/_hours.pug
include mixins/_phone.pug
include mixins/_nav-list.pug
include mixins/_logo.pug
include mixins/_menu-toggle.pug
include mixins/_search-form.pug
include mixins/_user-action-item.pug
include mixins/_category-tab.pug
include mixins/_build-pc-button.pug
include mixins/_menu-item.pug
include mixins/_menu-panel.pug


-
	const categoryTabsData = [
		{ href: '/sales', iconName: 'fire', label: 'Акции' },
		{ href: '/hot', iconName: 'lighting', label: 'Горячее предложение' },
		{ href: '/gifts', iconName: 'chest-with-skull', label: 'Подарочные наборы' },
		{ href: '/events', iconName: 'quest', label: 'События' },
		{ href: '/brands', iconName: 'orc', label: 'Наши бренды' }
	]

#header-observer-sentinel(style="height: 0; pointer-events: none; visibility: hidden;")
header.header#main-header
	.top.header__top 
		.container.top__container 
			.top__info 
				+languageSwitcher({
					classes: 'top__language-switcher',
					currentLanguage: 'ru'
				})
				+location({
					classes: 'top__location',
				})
				+phone({
					classes: 'top__phone',
				})
			+hours({classes: 'top__hours'})
			+nav-list({
				classes: 'top__nav', 
				items:['Доставка', 'Оплата', 'Контакты']
			})

	.center.header__center
		.container.center__container
			+logo({classes: 'center__logo'})
			+menuToggle({ classes: 'center__menu-toggle', controlsId: 'megaMenu' })
			+searchForm({
				classesForm: 'center__search-form',
				buttonIconId: 'search'
			})
			.socials.center__socials 
				+actionItem({ href: '/', iconName: 'telegram', iconClass: 'socials__icon socials__icon--telegram', classes: 'socials__item socials__item--telegram' })
				+actionItem({ href: '/', iconName: 'whatsapp', iconClass: 'socials__icon socials__icon--whatsapp',  classes: 'socials__item socials__item--whatsapp' })
			+languageSwitcher({
				classes: 'center__language-switcher',
				currentLanguage: 'ru'
			})
			.user-actions.center__user-actions
				+actionItem({ href: '/wishlist', iconName: 'heart', iconClass: 'user-actions__icon  user-actions__icon--heart', ariaLabel: 'Избранное', classes: 'user-actions__item user-actions__item--wishlist' })
				+actionItem({ href: '/compare', iconName: 'hunter', iconClass: 'user-actions__icon  user-actions__icon--compare', ariaLabel: 'Сравнение', classes: 'user-actions__item user-actions__item--compare' })
				+actionItem({ href: '/cart', iconName: 'chest', iconClass: 'user-actions__icon  user-actions__icon--cart', ariaLabel: 'Корзина', badgeCount: '20', classes: 'user-actions__item user-actions__item--cart' })

	.bottom.header__bottom
		.container.bottom__container
			nav.category-tabs.bottom__category-tabs
				ul.category-tabs__list
					each tab in categoryTabsData
						+categoryTab(tab)
			+buildPcButton({ classes: 'bottom__build-pc-button' })

main.main
	section.hero
		.container.hero__container
			.hero__content
				h1.hero__title Отправляйся в приключения с нашими эпическими лут-корзинами и наборами!
				p.hero__description Развивай свои навыки, следуя мудрым стратегиям мастеров, и поднимайся на новый уровень мастерства! С нашей поддержкой каждое твое действие станет частью великого искусства, а победы — результатом точного плана и безупречной подготовки!
				a.button.hero__button(href="#catalog") В каталог
	section.author-info
		.container.author-info__container
			h2.author-info__title Информация об авторе
			p.author-info__name
				strong Судоргин Даниил Дмитриевич
			ul.author-info__contacts
				li.author-info__contact-item
					| GitHub:
					a.author-info__contact-link(href="https://github.com/Zilusion" target="_blank" rel="noopener noreferrer") https://github.com/Zilusion
				li.author-info__contact-item
					| Telegram:
					a.author-info__contact-link(href="https://t.me/sudorgindaniil" target="_blank" rel="noopener noreferrer") @sudorgindaniil
				li.author-info__contact-item
					| Телефон:
					a.author-info__contact-link(href="tel:+79258769646") +7 (925) 876-96-46
				li.author-info__contact-item
					| Email:
					a.author-info__contact-link(href="mailto:ddsudorgin@gmail.com") ddsudorgin@gmail.com


nav#megaMenu.mega-menu(aria-label="Основное меню" data-hover-delay="200")
	.container.mega-menu__container

		+menuPanel({ panelId: 'entry', isRoot: true, panelClasses: 'mega-menu__panel--entry' })
			.mega-menu__mobile-header-info
				+location({
					classes: 'menu__location',
					location: 'г. Москва'
				})
				+hours({classes: 'menu__hours', needIcon: true})
				.socials.menu__socials 
					+actionItem({ href: '/', iconName: 'telegram', iconClass: 'socials__icon socials__icon--telegram', classes: 'socials__item socials__item--telegram' })
					+actionItem({ href: '/', iconName: 'whatsapp', iconClass: 'socials__icon socials__icon--whatsapp',  classes: 'socials__item socials__item--whatsapp' })


			ul.mega-menu__nav-list(role="menu")
				+menuItem({ title: 'Каталог', iconName: 'catalog', opensPanel: 'root', itemClasses: 'has-submenu' })
				each tab in categoryTabsData
					+menuItem({ title: tab.label, iconName: tab.iconName, href: tab.href })
			.mega-menu__actions
				+buildPcButton({ classes: 'mobile-menu__build-pc' })
			+nav-list({ classes: 'mobile-menu__footer-nav', items:['Доставка', 'Оплата', 'Контакты'] })


		h2#mega-menu-main-heading.visually-hidden Основные разделы каталога
		+menuPanel({
			panelId: 'root',
			isRoot: false,
			parentPanelId: 'entry', 
			title: 'Каталог',
			panelClasses: 'mega-menu__panel--root-categories', 
			ariaLabelledby: 'mega-menu-main-heading'
		})
			ul.mega-menu__nav-list(role="menu")
				+menuItem({ title: 'Смартфоны и гаджеты', iconName: 'mobile', opensPanel: 'smartphones-gadgets', itemClasses: 'has-submenu' })
				+menuItem({ title: 'Ноутбуки и компьютеры', iconName: 'laptop', opensPanel: 'laptops', itemClasses: 'has-submenu' })
				+menuItem({ title: 'Телевизоры и цифровое ТВ', iconName: 'tv', opensPanel: 'tv', itemClasses: 'has-submenu' })
				+menuItem({ title: 'Аудиотехника', iconName: 'speaker', opensPanel: 'audio', itemClasses: 'has-submenu' })
				+menuItem({ title: 'Акции', iconName: 'fire', href: '/sales' })
				+menuItem({ title: 'Новинки', iconName: 'new', href: '/new' })


		+menuPanel({ panelId: 'smartphones-gadgets', level: 2, parentPanelId: 'root', title: 'Смартфоны и гаджеты', panelClasses: 'mega-menu__panel--has-columns' })
			.mega-menu__column
				h3.mega-menu__column-title Смартфоны
				ul.mega-menu__nav-list(role="menu")
					+menuItem({ title: 'Apple iPhone', href: '/catalog/apple', count: 123 })
