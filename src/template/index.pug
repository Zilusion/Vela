mixin menuItem(options = {})
	- const title = options.title
	- const iconName = options.iconName
	- const opensPanel = options.opensPanel
	- const href = options.href || '#'
	- const count = options.count
	- const itemClasses = options.itemClasses || ''
	- const linkClasses = options.linkClasses || ''
	- const isParent = !!opensPanel

	li.mega-menu__nav-item(class=itemClasses, role="menuitem")
		a.mega-menu__nav-link(
			href=href,
			class=linkClasses,
			data-opens-panel=opensPanel,
			aria-haspopup=(isParent ? "true" : null)
		)
			if iconName
				+icon({ name: iconName, classes: 'mega-menu__nav-icon' })
			span.mega-menu__nav-label= title
			if count
				span.mega-menu__nav-count= count
			if isParent
				+icon({ name: 'arrow-right', classes: 'mega-menu__nav-arrow' })

mixin menuPanel(options = {})
	- const panelId = options.panelId 
	- const level = options.level || 1
	- const title = options.title
	- const parentPanelId = options.parentPanelId
	- const isRoot = options.isRoot || false
	- const panelClasses = options.panelClasses || ''
	- const ariaLabelledby = options.ariaLabelledby

	.mega-menu__panel(
		class=`mega-menu__panel--level-${level}`
		class=panelClasses
		data-panel-id=panelId
		data-parent-panel-id=parentPanelId 
		hidden=!isRoot 
		role="region" 
		aria-labelledby=ariaLabelledby 
	)
		.mega-menu__header.mega-menu__header--mobile-only
			button.mega-menu__back-button(type="button", data-closes-panel=panelId, data-opens-panel=parentPanelId)
				+icon({ name: 'left' })
				| Назад
			if title
				span.mega-menu__title= title

		.mega-menu__panel-content
			if block
				block

nav#megaMenu.mega-menu(aria-label="Основное меню" data-hover-delay="200")
	.container.mega-menu__container

		//- ==========================================================
		//- Panel 0: Mobile Entry Point (NEW)
		//-         (Contains utility links + "Catalog" trigger)
		//-         This panel is effectively ignored on desktop by CSS/JS
		//- ==========================================================
		+menuPanel({ panelId: 'entry', isRoot: true, panelClasses: 'mega-menu__panel--entry' })
			.mega-menu__mobile-header-info
				+location({
					classes: 'menu__location',
				})
				+hours({classes: 'menu__hours', needIcon: true})
				.socials.menu__socials 
					+actionItem({ href: '/', iconName: 'telegram', iconClass: 'socials__icon socials__icon--telegram', classes: 'socials__item socials__item--telegram' })
					+actionItem({ href: '/', iconName: 'whatsapp', iconClass: 'socials__icon socials__icon--whatsapp',  classes: 'socials__item socials__item--whatsapp' })


			//- Основная навигация первого уровня МОБИЛЬНОГО меню
			ul.mega-menu__nav-list(role="menu")
				+menuItem({ title: 'Каталог', iconName: 'catalog', opensPanel: 'root', itemClasses: 'has-submenu' })
				each tab in categoryTabsData
					+menuItem({ title: tab.label, iconName: tab.iconName, href: tab.href })
			.mega-menu__actions
				+buildPcButton({ classes: 'mobile-menu__build-pc' })
			+nav-list({ classes: 'mobile-menu__footer-nav', items:['Доставка', 'Оплата', 'Контакты'] })


		//- ==========================================================
		//- Panel 1: Main Categories (Previously 'root')
		//-         (Opened by "Catalog" on mobile, visible by default on desktop)
		//- ==========================================================
		//- Теперь это НЕ isRoot, и имеет parentPanelId = 'entry'
		h2#mega-menu-main-heading.visually-hidden Основные разделы каталога
		+menuPanel({
			panelId: 'root',
			isRoot: false,
			parentPanelId: 'entry', 
			title: 'Каталог',
			panelClasses: 'mega-menu__panel--root-categories', 
			ariaLabelledby: 'mega-menu-main-heading'
		})
			ul.mega-menu__nav-list(role="menu")
				+menuItem({ title: 'Смартфоны и гаджеты', iconName: 'mobile', opensPanel: 'smartphones-gadgets', itemClasses: 'has-submenu' })
				+menuItem({ title: 'Ноутбуки и компьютеры', iconName: 'laptop', opensPanel: 'laptops', itemClasses: 'has-submenu' })
				+menuItem({ title: 'Телевизоры и цифровое ТВ', iconName: 'tv', opensPanel: 'tv', itemClasses: 'has-submenu' })
				+menuItem({ title: 'Аудиотехника', iconName: 'speaker', opensPanel: 'audio', itemClasses: 'has-submenu' })
				+menuItem({ title: 'Акции', iconName: 'fire', href: '/sales' })
				+menuItem({ title: 'Новинки', iconName: 'new', href: '/new' })


		//- ==========================================================
		//- Panel 2: Sub-categories (smartphones-gadgets, laptops, etc.)
		//- ==========================================================
		+menuPanel({ panelId: 'smartphones-gadgets', level: 2, parentPanelId: 'root', title: 'Смартфоны и гаджеты', panelClasses: 'mega-menu__panel--has-columns' })
			.mega-menu__column
				h3.mega-menu__column-title Смартфоны
				ul.mega-menu__nav-list(role="menu")
			.mega-menu__column
				h3.mega-menu__column-title Гаджеты
				ul.mega-menu__nav-list(role="menu")

		+menuPanel({ panelId: 'laptops', level: 2, parentPanelId: 'root', title: 'Ноутбуки и компьютеры' })
			p Содержимое для ноутбуков...
		+menuPanel({ panelId: 'tv', level: 2, parentPanelId: 'root', title: 'Телевизоры и цифровое ТВ' })
			p Содержимое для ТВ...
		+menuPanel({ panelId: 'audio', level: 2, parentPanelId: 'root', title: 'Аудиотехника' })
			p Содержимое для Аудио...

