					+menuItem({ title: 'Портативная акустика', href: '/catalog/portable-speakers', count: 142 })
					+menuItem({ title: 'Умные гаджеты', href: '/catalog/smart-gadgets', count: 46 })
					+menuItem({ title: 'VR-очки и шлемы', href: '/catalog/vr', count: 49 })
					+menuItem({ title: 'Внешние аккумуляторы', href: '/catalog/powerbanks', count: 205 })
					+menuItem({ title: 'Аксессуары для гаджетов', href: '/catalog/gadget-accessories', count: 500 })


		+menuPanel({ panelId: 'laptops', level: 2, parentPanelId: 'root', title: 'Ноутбуки и компьютеры' })
			ul.mega-menu__nav-list(role="menu")
				+menuItem({ title: 'Ноутбуки', href: '/catalog/laptops', count: 450 })
				+menuItem({ title: 'Игровые ноутбуки', href: '/catalog/gaming-laptops', count: 120 })
				+menuItem({ title: 'Ультрабуки', href: '/catalog/ultrabooks', count: 90 })
				+menuItem({ title: 'Планшеты', href: '/catalog/tablets', count: 280 })
				+menuItem({ title: 'Моноблоки', href: '/catalog/all-in-one', count: 60 })
				+menuItem({ title: 'Системные блоки', href: '/catalog/desktops', count: 150 })
				+menuItem({ title: 'Мониторы', href: '/catalog/monitors', count: 310 })
				+menuItem({ title: 'Комплектующие для ПК', href: '/catalog/pc-parts', count: 78  })


		+menuPanel({ panelId: 'tv', level: 2, parentPanelId: 'root', title: 'Телевизоры и цифровое ТВ' })
			ul.mega-menu__nav-list(role="menu")
				+menuItem({ title: 'Телевизоры LED', href: '/catalog/tv/led', count: 250 })
				+menuItem({ title: 'Телевизоры QLED', href: '/catalog/tv/qled', count: 80 })
				+menuItem({ title: 'Телевизоры OLED', href: '/catalog/tv/oled', count: 55 })
				+menuItem({ title: 'Проекторы', href: '/catalog/projectors', count: 70 })
				+menuItem({ title: 'Саундбары', href: '/catalog/soundbars', count: 95 })
				+menuItem({ title: 'ТВ-приставки и медиаплееры', href: '/catalog/media-players', count: 110 })
